// The "Enter a link" window (ui-alignment §7.5 UI-DLG-02): the same layout and size as the VestraTube window.
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";

export component BilibiliWindow inherits Window {
    // TRANSLATORS: the plugin's name (a brand); usually kept as it is.
    title: @tr("VestraBili");
    width: 420px;
    height: 122px;
    background: Theme.bg-panel;
    in-out property <string> url;
    in-out property <string> status: @tr("Enter a Bilibili video link.");
    in-out property <bool> busy: false;
    callback play(string);
    callback cancel();
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 8px;
        Text { text: @tr("Enter a link"); color: Theme.text; font-size: Theme.font-body; height: Theme.label-height; }
        LineEdit {
            height: Theme.input-height;
            font-size: Theme.font-body;
            text <=> root.url;
            placeholder-text: "https://www.bilibili.com/video/BV…"; // i18n-ignore: an example link, not words
            enabled: !root.busy;
            accepted => { root.play(root.url); }
        }
        // One line; the full text is in the tooltip.
        Rectangle {
            height: Theme.label-height;
            ToolTipArea {
                text: root.status;
                Text {
                    text: root.status;
                    color: Theme.text-list;
                    font-size: Theme.font-body;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Play"); enabled: !root.busy; clicked => { root.play(root.url); } }
            Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
        }
    }
}
