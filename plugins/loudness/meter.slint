// The Loudness Meter window: momentary and short-term loudness as bars, integrated loudness, loudness range
// and the highest true peak as numbers, a status line and Restart.
// The small-adjustment-window layout (301 wide, rows 24 high, content 8 from the edges); the height follows the content.
// The bars use EBU Tech 3341's "EBU +18" scale (−59 to −5 LUFS); main.ts computes the fill (0 to 1).
// No animation: a bar moves only when a new value arrives (at most ten a second), so the window redraws no more.
// Texts are @tr (English source; locales/<lang>.po translate them); units (LUFS, LU, dBTP) are not translated.
import { Theme } from "@vestra/theme.slint";
import { Button } from "@vestra/widgets.slint";

// One meter row: label, an optional bar, the value and its unit.
component MeterRow {
    in property <string> label;
    in property <string> value;
    in property <string> unit;
    in property <bool> has-bar;
    in property <float> level;
    in property <bool> warn;
    height: 24px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            min-width: 76px;
            text: root.label;
            color: Theme.text-dim;
            font-size: Theme.font-body;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Rectangle {
            horizontal-stretch: 1;
            if root.has-bar: Rectangle {
                y: (parent.height - self.height) / 2;
                height: 6px;
                border-radius: 3px;
                background: Theme.line;
                clip: true;
                Rectangle {
                    x: 0;
                    width: parent.width * root.level;
                    height: parent.height;
                    background: Theme.accent-fill;
                }
            }
        }
        Text {
            width: 44px;
            text: root.value;
            color: root.warn ? Theme.danger : Theme.text;
            font-family: Theme.font-mono;
            font-size: Theme.font-body;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        Text {
            width: 30px;
            text: root.unit;
            color: Theme.text-dim;
            font-size: Theme.font-xs;
            vertical-alignment: center;
        }
    }
}

export component MeterWindow inherits Window {
    title: @tr("Loudness Meter");
    width: 301px;
    preferred-height: body.preferred-height;
    min-height: body.preferred-height;
    max-height: body.preferred-height;
    background: Theme.bg-bar;
    // The values as shown ("−18.3", "—" when not measured) and the bars' fill (0 to 1).
    in property <string> momentary: "—";
    in property <float> momentary-level;
    in property <string> short-term: "—";
    in property <float> short-term-level;
    in property <string> integrated: "—";
    in property <string> range: "—";
    in property <string> true-peak: "—";
    // The true peak is above EBU R128's −1 dBTP.
    in property <bool> peak-over;
    // The status line and its tone: 0 idle, 1 measuring, 2 waiting, 3 failed.
    in property <string> status;
    in property <int> tone;
    in property <bool> can-restart;
    callback restart();

    body := VerticalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 2px;
        MeterRow { label: @tr("Momentary"); value: root.momentary; unit: "LUFS"; has-bar: true; level: root.momentary-level; }
        MeterRow { label: @tr("Short-term"); value: root.short-term; unit: "LUFS"; has-bar: true; level: root.short-term-level; }
        MeterRow { label: @tr("Integrated"); value: root.integrated; unit: "LUFS"; }
        MeterRow { label: @tr("Range"); value: root.range; unit: "LU"; }
        MeterRow { label: @tr("True peak"); value: root.true-peak; unit: "dBTP"; warn: root.peak-over; }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            spacing: 8px;
            padding-top: 6px;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: 4px;
                    background: root.tone == 1 ? Theme.playing : root.tone == 2 ? Theme.accent : root.tone == 3 ? Theme.danger : Theme.icon-disabled;
                }
            }
            Text {
                horizontal-stretch: 1;
                text: root.status;
                color: root.tone == 3 ? Theme.danger : Theme.text-list;
                font-size: Theme.font-body;
                vertical-alignment: center;
                wrap: word-wrap;
            }
            Button {
                text: @tr("Restart");
                enabled: root.can-restart;
                clicked => { root.restart(); }
            }
        }
    }
}
