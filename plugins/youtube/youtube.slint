// The "Enter a link" window (ui-alignment §7.5 UI-DLG-02): the same layout and size as the Bilibili window.
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";

export component YouTubeWindow inherits Window {
    // TRANSLATORS: the plugin's name (a brand); usually kept as it is.
    title: @tr("VestraTube");
    width: 420px;
    height: 122px;
    background: Theme.bg-panel;
    in-out property <string> url: "";
    in-out property <string> status: @tr("Paste a YouTube video link to play or download it.");
    in-out property <bool> busy: false;
    in-out property <float> progress: 0;
    callback play(string);
    callback download(string);
    callback cancel();
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 8px;
        Text { text: @tr("Enter a link"); color: Theme.text; font-size: Theme.font-body; height: Theme.label-height; }
        LineEdit {
            height: Theme.input-height;
            font-size: Theme.font-body;
            text <=> root.url;
            placeholder-text: "https://www.youtube.com/watch?v=…"; // i18n-ignore: an example link, not words
            enabled: !root.busy;
            accepted => { root.play(root.url); }
        }
        // One line; the full text is in the tooltip. Downloads draw a 2px progress line under it.
        Rectangle {
            height: Theme.label-height;
            ToolTipArea {
                text: root.status;
                Text {
                    text: root.status;
                    color: Theme.text-list;
                    font-size: Theme.font-body;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            if root.busy && root.progress > 0: Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.bg-bar;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.progress, 0, 1);
                    background: Theme.playing;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Button { text: @tr("Download Video…"); enabled: !root.busy; clicked => { root.download(root.url); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: @tr("Play"); enabled: !root.busy; clicked => { root.play(root.url); } }
            Button { text: @tr("Cancel"); clicked => { root.cancel(); } }
        }
    }
}
