// 「输入链接」小窗（ui-alignment §7.5 UI-DLG-02）：与 Bilibili 窗口同一规格、同一尺寸。
import { LineEdit } from "std-widgets.slint";
import { Theme } from "@vestra/theme.slint";
import { Button, ToolTipArea } from "@vestra/widgets.slint";

export component YouTubeWindow inherits Window {
    title: "YouTube 视频";
    width: 420px;
    height: 122px;
    background: Theme.bg-panel;
    in-out property <string> url: "";
    in-out property <string> status: "粘贴 YouTube 视频链接以播放或下载。";
    in-out property <bool> busy: false;
    in-out property <float> progress: 0;
    callback play(string);
    callback download(string);
    callback cancel();
    VerticalLayout {
        padding: Theme.dialog-padding;
        spacing: 8px;
        Text { text: "输入链接"; color: Theme.text; font-size: Theme.font-body; height: Theme.label-height; }
        LineEdit {
            height: Theme.input-height;
            font-size: Theme.font-body;
            text <=> root.url;
            placeholder-text: "https://www.youtube.com/watch?v=…";
            enabled: !root.busy;
            accepted => { root.play(root.url); }
        }
        // One line; the full text is in the tooltip. Downloads draw a 2px progress line under it.
        Rectangle {
            height: Theme.label-height;
            ToolTipArea {
                text: root.status;
                Text {
                    text: root.status;
                    color: Theme.text-list;
                    font-size: Theme.font-body;
                    overflow: elide;
                    vertical-alignment: center;
                }
            }
            if root.busy && root.progress > 0: Rectangle {
                y: parent.height - 2px;
                height: 2px;
                background: Theme.bg-bar;
                Rectangle {
                    x: 0;
                    width: parent.width * clamp(root.progress, 0, 1);
                    background: Theme.playing;
                }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Button { text: "下载视频…"; enabled: !root.busy; clicked => { root.download(root.url); } }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "播放"; enabled: !root.busy; clicked => { root.play(root.url); } }
            Button { text: "取消"; clicked => { root.cancel(); } }
        }
    }
}
