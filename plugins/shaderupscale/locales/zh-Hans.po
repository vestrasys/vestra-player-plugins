msgstr "着色器超分辨率：开，{}"

#: main.ts:227
msgid "Shader Upscaling: ArtCNN does not run on macOS"
msgstr "着色器超分辨率：ArtCNN 无法在 macOS 上运行"

#: main.ts:228
msgid "Shader Upscaling needs GPU rendering"
msgstr "着色器超分辨率需要 GPU 渲染"

