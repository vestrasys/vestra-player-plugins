msgid "video"
msgstr "视频"

#: manifest.json
msgid "upscaling"
msgstr "超分辨率"

#: manifest.json
msgid "shaders"
msgstr "着色器"

#: manifest.json
msgid "anime"
msgstr "动画"

#: manifest.json
msgid "sharpening"
msgstr "锐化"

