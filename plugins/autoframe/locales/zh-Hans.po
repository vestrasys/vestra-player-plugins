msgid "Auto Frame: Off"
msgstr "自动取景：关"

#: main.ts:599
msgid "Auto Frame: On"
msgstr "自动取景：开"

#: main.ts:607
msgid "Detect Again"
msgstr "重新检测"

#: main.ts:613 main.ts:625
msgid "Auto-Frame Videos is off"
msgstr "“自动取景视频”已关闭"

#: main.ts:615
