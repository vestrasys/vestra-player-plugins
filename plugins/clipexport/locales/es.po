msgid "Fast: part {0} is {1}, part 1 is {2}"
msgstr "Rápido: la parte {0} es {1}, la parte 1 es {2}"

#: ui/tab.slint:1300
msgid "Switched to Precise: transitions need re-encoding."
msgstr "Cambiado a Preciso: las transiciones necesitan recodificar."

