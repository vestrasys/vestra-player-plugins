{
  "name": "vestra-player-plugins",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vestrasys/vestra-player-plugins.git"
  },
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "check": "node scripts/plugin.mjs check --all && tsc --noEmit",
    "format": "prettier --write \"scripts/**/*.mjs\" \".github/**/*.yml\" package.json tsconfig.json revoked.json",
    "format:check": "prettier --check \"scripts/**/*.mjs\" \".github/**/*.yml\" package.json tsconfig.json revoked.json",
    "boundaries": "node scripts/check-boundaries.mjs",
    "portability": "node scripts/check-portability.mjs",
    "registry": "node scripts/check-registry.mjs",
    "plugin": "node scripts/plugin.mjs",
    "deps": "node scripts/plugin-deps.mjs",
    "build": "node scripts/plugin.mjs build --all",
    "test": "node scripts/plugin.mjs test --all && npm run test:scripts",
    "test:scripts": "node --test \"scripts/tests/*.test.mjs\"",
    "index:dry-run": "node scripts/build-index.mjs --dry-run"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vestra-player/sdk": "^1.5.20",
    "esbuild": "0.25.12",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0"
  }
}
